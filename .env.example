# API
APP_ENV=dev
APP_NAME=Aroundyou API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:19006,http://localhost:8081

# Postgres (PostGIS)
DATABASE_URL=postgresql+asyncpg://aroundyou:aroundyou@localhost:5432/aroundyou

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Auth
JWT_SECRET=change_me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=43200
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# For Expo Go on device, prefer HTTPS public callback (Cloudflare tunnel URL).
# Example: https://abc123.trycloudflare.com/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_AUTH_SUCCESS_URL=http://localhost:8082
